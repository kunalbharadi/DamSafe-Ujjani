# DamSafe Environment Configuration Example
# Copy to .env and configure as needed.

# Earth Engine Settings (Optional for live satellite queries)
EE_PROJECT=your-google-earth-engine-project-id
EE_SERVICE_ACCOUNT_JSON=C:/path/to/gee-key.json

# Storage Configuration
DAMSAFE_STORAGE=local
DAMSAFE_STORAGE_ROOT=.local/objects

# S3 Storage Settings (Only if DAMSAFE_STORAGE=s3)
# DAMSAFE_S3_ENDPOINT=https://s3.us-west-2.amazonaws.com
# DAMSAFE_S3_BUCKET=damsafe-storage-bucket

# Deployment Mode Security Declaration
DAMSAFE_DEPLOYMENT_MODE=LOCAL_DEMO_ONLY

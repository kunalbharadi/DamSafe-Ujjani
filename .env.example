# DamSafe Environment Configuration Example
# Copy to .env and configure as needed.

# Earth Engine Settings (Optional for live satellite queries)
EE_PROJECT=
# Leave blank for interactive OAuth (earthengine authenticate).
# Or specify an absolute path OUTSIDE this repository to a service-account JSON.
EE_SERVICE_ACCOUNT_JSON=

# Storage Configuration
DAMSAFE_STORAGE=local
DAMSAFE_STORAGE_ROOT=.local/objects
DAMSAFE_RUN_ROOT=.local/runs
# start.ps1 -Preview supplies an absolute SQLite URL automatically.
# Direct API/worker startup can use:
# DAMSAFE_DATABASE_URL=sqlite:///.local/damsafe.db

# S3 Storage Settings (Only if DAMSAFE_STORAGE=s3)
# DAMSAFE_S3_ENDPOINT=https://s3.us-west-2.amazonaws.com
# DAMSAFE_S3_BUCKET=damsafe-storage-bucket

# Deployment Mode Security Declaration
DAMSAFE_DEPLOYMENT_MODE=LOCAL_DEMO_ONLY

# No Google Maps, Cesium, Mapbox, OpenAI or Gemini API key is used by this UI.
# The map uses OpenStreetMap; Three.js displays saved numerical results locally.
